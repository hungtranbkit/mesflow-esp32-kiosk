# Inactive example only. Do not install/start until a staging admin provisions
# the exact service token/hash, target UUID allowlist, manifest and USB access.
[Unit]
Description=MESFlow trusted USB kiosk provisioner (example)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mesflow-kiosk-provisioner
SupplementaryGroups=dialout
ExecStart=/usr/bin/python3 /opt/mesflow-kiosk-provisioner/m910_usb_provisioner.py --config /etc/mesflow/kiosk-provisioner/provisioner.toml
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/mesflow-kiosk-provisioner

[Install]
WantedBy=multi-user.target
